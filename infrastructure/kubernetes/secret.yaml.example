# Template only — copy to secret.yaml, fill in real values, and keep
# secret.yaml out of version control (it's already gitignored via
# infrastructure/kubernetes/secret.yaml in .gitignore-style discipline: never
# commit real secrets). In a real deployment this would be generated by
# your secret manager (Vault, External Secrets Operator, sealed-secrets, or
# your cloud provider's KMS-backed secret store) — not hand-applied.
apiVersion: v1
kind: Secret
metadata:
  name: sentinel-secrets
  namespace: sentinellm
type: Opaque
stringData:
  SENTINEL_SECRET_KEY: "replace-with-a-long-random-value"
  SENTINEL_DATABASE_URL: "postgresql+psycopg://sentinel:REPLACE_ME@postgres:5432/sentinellm"
  SENTINEL_REDIS_URL: "redis://redis:6379/0"
  SENTINEL_DEMO_API_KEY: "replace-with-a-generated-key"
  OPENAI_API_KEY: ""
  ANTHROPIC_API_KEY: ""
  SENTINEL_ALERT_WEBHOOK_URL: ""
  POSTGRES_PASSWORD: "REPLACE_ME"

# ---- Core ----
SENTINEL_ENV=local
SENTINEL_LOG_LEVEL=INFO
SENTINEL_SECRET_KEY=change-me-in-production

# ---- Database ----
# Local dev / docker-compose default. Tests override this to sqlite automatically.
SENTINEL_DATABASE_URL=postgresql+psycopg://sentinel:sentinel@localhost:5432/sentinellm

# ---- Redis (job queue + semantic cache) ----
SENTINEL_REDIS_URL=redis://localhost:6379/0

# ---- LLM providers ----
# Leave unset to run entirely on the deterministic MockProvider (no external API calls, no cost).
# Requests choose their model per call by `provider:model` id (register real ones with
# POST /api/v1/models, e.g. openai:gpt-4o-mini); this setting picks the DEFAULT
# LLM-as-judge model family (mock -> mock:sentinel-judge, openai -> openai:gpt-4o-mini,
# anthropic -> anthropic:claude-haiku-4-5-20251001). Set SENTINEL_JUDGE_MODEL to override.
SENTINEL_LLM_PROVIDER=mock
# SENTINEL_JUDGE_MODEL=openai:gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Embeddings ----
SENTINEL_EMBEDDING_PROVIDER=mock

# ---- Semantic cache ----
SENTINEL_CACHE_ENABLED=true
SENTINEL_CACHE_SIMILARITY_THRESHOLD=0.95
# Seconds a cached response may be replayed (0 = never expire).
SENTINEL_CACHE_TTL_SECONDS=86400

# ---- Security hooks ----
# Off by default: redaction is lossy and can itself skew evaluation quality.
# See docs/security.md before enabling in an environment with real user data.
SENTINEL_PII_REDACTION_ENABLED=false

# ---- Router weights (must sum to 1.0) ----
SENTINEL_ROUTER_QUALITY_WEIGHT=0.35
SENTINEL_ROUTER_COST_WEIGHT=0.35
SENTINEL_ROUTER_LATENCY_WEIGHT=0.15
SENTINEL_ROUTER_RISK_WEIGHT=0.15

# ---- Regression detection ----
SENTINEL_REGRESSION_THRESHOLD_PCT=5.0

# ---- Alerting ----
SENTINEL_ALERT_WEBHOOK_URL=
# generic (default) posts {rule, current_value, ...}; slack posts {text: "..."}
# and works directly with a Slack Incoming Webhook URL.
SENTINEL_ALERT_WEBHOOK_FORMAT=generic
SENTINEL_HALLUCINATION_RATE_THRESHOLD=0.08
SENTINEL_P95_LATENCY_THRESHOLD_MS=3000
SENTINEL_ERROR_RATE_THRESHOLD=0.05
SENTINEL_QUALITY_SCORE_THRESHOLD=0.85
SENTINEL_DAILY_COST_BUDGET=50.0

# ---- API ----
SENTINEL_API_HOST=0.0.0.0
SENTINEL_API_PORT=8000
SENTINEL_RATE_LIMIT_PER_MINUTE=120
# Request bodies larger than this are refused with a 413.
SENTINEL_MAX_REQUEST_BYTES=10000000
# Seconds `/generate` caches an application's budget check (enforced budgets are approximate).
SENTINEL_BUDGET_CACHE_SECONDS=10

# ---- Worker ----
# The worker serves its own Prometheus metrics (the API can't see them). 0 disables.
SENTINEL_WORKER_METRICS_PORT=9100
# Cadence of the regression / alerting / model-health / rollout loops.
SENTINEL_WORKER_INTERVAL_SECONDS=60

# ---- Demo/seed API key (dev only) ----
SENTINEL_DEMO_API_KEY=demo-api-key

# ---- Tracing ----
# Unset = tracing off. Set to an OTLP/gRPC collector to trace the API and worker.
# SENTINEL_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
